generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model MenuItem {
    id                  String               @id @default(cuid())
    name                String
    description         String
    price               Float
    kingdom             String               // LIREO | SAPIRO | HATHORIA | ADAMYA
    category            String               // Appetizers | Mains | Banquets | Potions | Desserts
    brilyanteSpiceLevel Int                  @default(0) // 0 to 4
    isAvailable         Boolean              @default(true)
    imageUrl            String
    isChefSpecial       Boolean              @default(false)
    dietary             String               @default("") // Comma-separated: Halal, Vegetarian, Gluten-Free
    recipe              MenuItemIngredient[]
    orderItems          OrderItem[]
    createdAt           DateTime             @default(now())
    updatedAt           DateTime             @updatedAt

    @@index([kingdom])
    @@index([category])
}

model Ingredient {
    id                 String               @id @default(cuid())
    name               String               @unique
    kingdom            String               @default("GENERAL") // LIREO | SAPIRO | HATHORIA | ADAMYA | GENERAL
    currentStock       Float
    unit               String               // kg | L | units | g
    lowStockThreshold  Float
    costPerUnit        Float                @default(0.0)
    usedIn             MenuItemIngredient[]
    createdAt          DateTime             @default(now())
    updatedAt          DateTime             @updatedAt
}

model MenuItemIngredient {
    id             String     @id @default(cuid())
    menuItemId     String
    ingredientId   String
    quantityNeeded Float
    menuItem       MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
    ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

    @@unique([menuItemId, ingredientId])
    @@index([menuItemId])
    @@index([ingredientId])
}

model Order {
    id                  String      @id @default(cuid())
    orderNumber         String      @unique // e.g. "AVI-2849"
    customerName        String
    customerPhone       String
    customerEmail       String?
    orderType           String      // DELIVERY | PICKUP
    status              String      @default("PENDING") // PENDING | PREPARING | READY | FULFILLED | CANCELLED
    deliveryAddress     String?
    pickupTime          String?
    specialInstructions String?
    paymentMethod       String      // GCASH | MAYA | CARD | GOLD
    paymentStatus       String      @default("PAID")
    subtotal            Float
    tax                 Float
    deliveryFee         Float       @default(0.0)
    discount            Float       @default(0.0)
    totalAmount         Float
    estimatedMinutes    Int         @default(30)
    items               OrderItem[]
    createdAt           DateTime    @default(now())
    updatedAt           DateTime    @updatedAt

    @@index([status])
    @@index([orderNumber])
}

model OrderItem {
    id         String   @id @default(cuid())
    orderId    String
    menuItemId String
    quantity   Int
    unitPrice  Float
    spiceLevel Int?
    notes      String?
    order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
    menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

    @@index([orderId])
    @@index([menuItemId])
}

model DiningTable {
    id           String        @id @default(cuid())
    tableNumber  String        @unique // e.g. "L-01", "H-02"
    realm        String        // LIREO_TERRACE | HATHORIAN_HEARTH | SAPIRO_HALL | ADAMYA_LAGOON
    capacity     Int
    status       String        @default("AVAILABLE") // AVAILABLE | OCCUPIED | RESERVED
    reservations Reservation[]

    @@index([realm])
    @@index([status])
}

model Reservation {
    id               String       @id @default(cuid())
    bookingReference String       @unique // e.g. "RES-4921"
    guestName        String
    guestPhone       String
    guestEmail       String
    reservationDate  DateTime
    timeSlot         String       // e.g. "12:00 PM", "07:00 PM"
    partySize        Int
    realmPreference  String       // LIREO_TERRACE | HATHORIAN_HEARTH | SAPIRO_HALL | ADAMYA_LAGOON
    specialRequests  String?
    status           String       @default("CONFIRMED") // CONFIRMED | SEATED | COMPLETED | CANCELLED
    tableId          String?
    table            DiningTable? @relation(fields: [tableId], references: [id])
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @updatedAt

    @@index([reservationDate])
    @@index([status])
}

model Staff {
    id              String  @id @default(cuid())
    fullName        String
    title           String
    kingdomAffinity String  // LIREO | SAPIRO | HATHORIA | ADAMYA
    role            String  // HEAD_CHEF | SOUS_CHEF | MIXOLOGIST | SERVER | HOST | RIDER
    contact         String
    avatarUrl       String?
    shifts          Shift[]
}

model Shift {
    id        String @id @default(cuid())
    staffId   String
    dayOfWeek String // Monday | Tuesday | Wednesday | Thursday | Friday | Saturday | Sunday
    startTime String // e.g. "08:00 AM"
    endTime   String // e.g. "04:00 PM"
    station   String // Kitchen Hearth | Elixir Bar | Dining Floor | Delivery Wing
    staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

    @@index([staffId])
    @@index([dayOfWeek])
}
